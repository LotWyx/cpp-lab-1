{
    "name": "C++ Lab Environment",
    "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",
    "features": {
        "ghcr.io/devcontainers/features/cmake:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools"
            ]
        }
    },
    "postCreateCommand": "sudo apt-get update && sudo apt-get install -y ninja-build",
    "runArgs": [
        "--cap-add=SYS_PTRACE",
        "--security-opt=seccomp=unconfined"
    ],
    "remoteUser": "vscode"
}
